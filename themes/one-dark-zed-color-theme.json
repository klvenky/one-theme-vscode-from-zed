    "namespace": "#dce0e5ff",
    "keyword": "#b477cfff",
    "modifier": "#b477cfff",
    "string": "#a1c181ff",
    "number": "#bf956aff",
    "regexp": "#bf956aff",
    "operator": "#6eb4bfff",
    "comment": "#5d636fff",
    "decorator": "#74ade8ff",
    "event": "#74ade8ff",
    "label": "#74ade8ff",
    "selfKeyword": "#bf956aff",
    "*.defaultLibrary": "#bf956aff"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5d636fff"
      }
    },
    {
      "name": "Documentation comment",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#878e98ff"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name",
        "support.variable"
      ],
      "settings": {
        "foreground": "#acb2beff"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#d07277ff"
      }
    },
    {
      "name": "Special variable",
      "scope": [
        "variable.language",
        "variable.other.this"
      ],
      "settings": {
        "foreground": "#bf956aff"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#d07277ff"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#acb2beff"
      }
    },
    {
      "name": "Brackets",
      "scope": [
        "punctuation.section",
        "punctuation.definition.block",
